# PostgreSQL connection (asyncpg driver). Keep credentials strong.
DATABASE_URL=postgresql+asyncpg://telemetry:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/telemetry

# Shared secret that the FreeCAD addon sends as "X-Api-Key".
# Grants POST /api/events ONLY. Public (shipped inside the open-source addon).
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEMETRY_API_KEY=CHANGE_ME_RANDOM_TOKEN

# Server-only secret — NEVER ship this in the addon or commit it.
# Required for GET/DELETE /api/events/{machine_id} and GET /api/stats.
# If unset, those read/delete endpoints are disabled (403).
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEMETRY_ADMIN_KEY=CHANGE_ME_ADMIN_TOKEN

# Bind address/port for the app. nginx proxies to this from 127.0.0.1.
HOST=127.0.0.1
PORT=7999

# Number of gunicorn worker processes.
GUNICORN_WORKERS=2
